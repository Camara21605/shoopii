{
  "expo": {
    "name": "Shoneya",
    "slug": "shoneya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shoneya",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.shoneya.app",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shoneya.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shoneya utilise votre position pour vous proposer les boutiques et livreurs proches de chez vous."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shoneya accède à vos photos pour choisir votre photo de profil, les envoyer dans vos messages ou choisir le logo de votre entreprise.",
          "cameraPermission": "Shoneya accède à votre appareil photo pour prendre votre photo de profil, ou une photo ou une vidéo à envoyer dans vos messages."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Shoneya accède à votre microphone pour les messages vocaux et les appels.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Shoneya accède à votre appareil photo pour les appels vidéo.",
          "microphonePermission": "Shoneya accède à votre microphone pour les appels audio et vidéo."
        }
      ],
      "expo-video",
      "expo-sharing",
      "./plugins/with-crop-labels",
      [
        "expo-media-library",
        {
          "photosPermission": "Shoneya accède à vos photos pour enregistrer les images et vidéos reçues dans vos conversations.",
          "savePhotosPermission": "Shoneya enregistre les images et vidéos reçues dans vos conversations sur votre appareil."
        }
      ],
      "./plugins/with-shareable-apk"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2775da79-3496-4777-86ac-b87b3637f7cc"
      }
    },
    "owner": "shoneya"
  }
}
