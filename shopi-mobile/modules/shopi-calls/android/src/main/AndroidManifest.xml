<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Écran d'appel affiché par-dessus l'écran verrouillé / téléphone en veille -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Chiffre sur l'icône (lanceurs qui ont leur propre canal) -->
  <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" />
  <uses-permission android:name="com.hihonor.android.launcher.permission.CHANGE_BADGE" />
  <uses-permission android:name="com.sec.android.provider.badge.permission.READ" />
  <uses-permission android:name="com.sec.android.provider.badge.permission.WRITE" />
  <uses-permission android:name="com.sonymobile.home.permission.PROVIDER_INSERT_BADGE" />
  <uses-permission android:name="com.htc.launcher.permission.UPDATE_SHORTCUT" />

  <!-- Android 11+ : voir les lanceurs qui écoutent ces annonces de chiffre -->
  <queries>
    <intent><action android:name="android.intent.action.BADGE_COUNT_UPDATE" /></intent>
    <intent><action android:name="com.sonyericsson.home.action.UPDATE_BADGE" /></intent>
    <intent><action android:name="com.htc.launcher.action.SET_NOTIFICATION" /></intent>
    <intent><action android:name="launcher.action.CHANGE_APPLICATION_NOTIFICATION_NUM" /></intent>
  </queries>

  <application>
    <!-- « Retirer le fond » : le modèle de détection du produit est installé avec l'application
         (services Google Play), pas au premier usage. -->
    <meta-data
      android:name="com.google.mlkit.vision.DEPENDENCIES"
      android:value="subject_segment" />

    <!-- Reçoit les push d'appel (data FCM haute priorité), application fermée comprise.
         Priorité haute : c'est ce service, et pas un autre, qui doit recevoir les messages. -->
    <service
      android:name="expo.modules.shopicalls.ShopiCallsMessagingService"
      android:exported="false">
      <intent-filter android:priority="100">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

    <!-- Bouton « Refuser » de la notification : fonctionne sans ouvrir l'application. -->
    <receiver
      android:name="expo.modules.shopicalls.CallDeclineReceiver"
      android:exported="false" />

    <!-- Boutons « Répondre » / « Marquer comme lu » des notifications de message. -->
    <receiver
      android:name="expo.modules.shopicalls.NotifActionReceiver"
      android:exported="false" />

    <!-- « Partager Shoneya » : donne l'APK de l'application aux applis de partage. -->
    <provider
      android:name="expo.modules.shopicalls.ShoneyaShareProvider"
      android:authorities="${applicationId}.shoneya.share"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/shoneya_share_paths" />
    </provider>
  </application>
</manifest>
